# Environment variables for the Portfolio CMS
# -------------------------------
# Never commit .env to version control.
# This file is an example - copy to .env and fill in real values.

# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://admin:admin@localhost:5434/portfolio_cms
DB_POOL_MAX=10
DB_SSL=false

# Media storage
MEDIA_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_DOCUMENT_MB=10
MEDIA_UPLOAD_TIMEOUT_MS=60000
LOCAL_UPLOAD_DIR=

# Admin
ADMIN_EMAIL=admin@paulocardoso.dev
ADMIN_PASSWORD=SuperSecurePassword123!
ADMIN_NAME=Paulo Cardoso
SESSION_TTL_HOURS=8
SESSION_COOKIE=pc_admin_session
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=8
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4000
PUBLIC_ORIGIN=
TRUST_PROXY=false
LOG_LEVEL=info
SEED_DEMO_CONTENT=true